{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    { "source": "/about-us", "destination": "/about", "permanent": true },
    {
      "source": "/contact-us-mobile-tyre-technicians",
      "destination": "/contact",
      "permanent": true
    },
    { "source": "/reviews-mobile-tyre-service", "destination": "/reviews", "permanent": true },
    {
      "source": "/coverage-areas-mobile-tyre-fitting",
      "destination": "/coverage-areas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_build/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(webp|avif|jpg|jpeg|png|svg|ico|woff2|woff|ttf|otf|mp4|webm)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brands.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(robots\\.txt|llms\\.txt|sitemap\\.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/((?!api/|_build/|assets/|__l5e/).*)",
      "missing": [{ "type": "header", "key": "x-no-cache" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
