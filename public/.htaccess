DirectoryIndex index.html
Options -MultiViews +FollowSymLinks
RewriteEngine On
RewriteBase /

# Direct pass-through for sitemap.xml, robots.txt and well-known files
RewriteRule ^(sitemap\.xml|robots\.txt|ai-catalog\.json|humans\.txt|ads\.txt|app-ads\.txt)$ - [L]

# 1. Canonical Redirect: Enforce https://www.samsmobiletyres.co.uk
# Redirect non-www to www
RewriteCond %{HTTP_HOST} ^samsmobiletyres\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://www.samsmobiletyres.co.uk/$1 [R=301,L]

# Redirect plain http to https (guarded for reverse-proxy/CDN SSL termination)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.samsmobiletyres.co.uk/$1 [R=301,L]

# 1a. Canonical URL normalization: strip /index.html, .html (except Google verification), and trailing slashes
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.samsmobiletyres.co.uk/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/google[a-f0-9]+\.html$ [NC]
RewriteRule ^(.+)\.html$ https://www.samsmobiletyres.co.uk/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.samsmobiletyres.co.uk/$1 [R=301,L]

# 1b. 301 Redirects for retired/legacy URLs to preserve SEO rankings
RewriteRule ^wheel-balancing/?$ https://www.samsmobiletyres.co.uk/services [R=301,L]
RewriteRule ^car-battery-replacement/?$ https://www.samsmobiletyres.co.uk/services [R=301,L]
RewriteRule ^about-us/?$ https://www.samsmobiletyres.co.uk/about [R=301,L]
RewriteRule ^contact-us-mobile-tyre-technicians/?$ https://www.samsmobiletyres.co.uk/contact [R=301,L]
RewriteRule ^reviews-mobile-tyre-service/?$ https://www.samsmobiletyres.co.uk/reviews [R=301,L]
RewriteRule ^coverage-areas-mobile-tyre-fitting/?$ https://www.samsmobiletyres.co.uk/coverage-areas [R=301,L]

# 1c. Security Headers
<IfModule mod_headers.c>
  # Content Security Policy (allows GTM, GA4, Ahrefs, Google Maps, inline hydration)
  Header set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://analytics.ahrefs.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src 'self' https://www.googletagmanager.com https://www.google.com https://maps.google.com; connect-src 'self' https: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self';"
  
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Anti-Clickjacking protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Referrer policy for privacy & accurate attribution
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Strict Transport Security (HSTS) - 1 year
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Modern Permissions Policy
  Header set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=()"
  
  # Anti-XSS Protection filter
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Ensure XML and JSON content types are correct
<Files "sitemap.xml">
  Header set Content-Type "application/xml; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
</Files>

<Files "ai-catalog.json">
  Header set Content-Type "application/json; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
</Files>

# Ensure crawler & security files have correct plain text encoding
<FilesMatch "^(robots\.txt|humans\.txt|ads\.txt|app-ads\.txt|security\.txt)$">
  Header set Content-Type "text/plain; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# 2. Prevent redirect loops or trailing slash on existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Clean URLs: Try to serve .html version of the requested path
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)/?$ $1.html [L]

# 4. Fallback: SPA catch-all
RewriteRule ^ index.html [L]

# Cache static assets for 1 year
<FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico|woff2|woff|ttf|otf|mp4|webm)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Cache HTML & XML for a short time
<FilesMatch "\.(html|xml)$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
